; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Файл: конфиг проекта гоночной игры «Velocity Atlas» (Godot 4.7.2).
; Разделы: application / autoload / display / input / physics / rendering.
; Бусы Music/SFX создаются в рантайме (AudioManager), поэтому секции [audio] нет.

config_version=5

[application]

config/name="Velocity Atlas"
config/description="Аркадные гонки на прохождение: Time Trial и Race с ботами. Godot 4.7.2, GDScript 2.0."
config/version="1.0.0"
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

InputBootstrap="*res://scripts/autoload/input_bootstrap.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
Records="*res://scripts/autoload/records.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

